      "facet": "C:Dili",
      "facetName": "Diligence",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO C:Dili (+ keyed)"
    },
    {
      "id": "H18",
      "displayOrder": 18,
      "text": "Do not like poetry.",
