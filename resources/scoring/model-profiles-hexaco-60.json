      "dimension": "H",
      "facet": "H:Mode",
      "facetName": "Modesty",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO H:Mode (- keyed)"
    },
    {
      "id": "H50",
      "displayOrder": 50,
      "text": "Am sensitive to the needs of others.",
