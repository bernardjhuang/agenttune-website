  "items": [
    {
      "id": "H01",
      "displayOrder": 1,
      "text": "Don't pretend to be more than I am.",
      "dimension": "H",
      "facet": "H:Sinc",
      "facetName": "Sincerity",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO H:Sinc (+ keyed)"
    },
    {
      "id": "H02",
      "displayOrder": 2,
      "text": "Begin to panic when there is danger.",
      "dimension": "E",
      "facet": "E:Fear",
      "facetName": "Fearfulness",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO E:Fear (+ keyed)"
    },
    {
      "id": "H03",
      "displayOrder": 3,
      "text": "Talk a lot.",
      "dimension": "X",
      "facet": "X:Expr",
      "facetName": "Expressiveness",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO X:Expr (+ keyed)"
    },
    {
      "id": "H04",
      "displayOrder": 4,
      "text": "Try to forgive and forget.",
      "dimension": "A",
      "facet": "A:Forg",
      "facetName": "Forgiveness",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO A:Forg (+ keyed)"
    },
    {
      "id": "H05",
      "displayOrder": 5,
      "text": "Keep things tidy.",
      "dimension": "C",
      "facet": "C:Orga",
      "facetName": "Organization",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO C:Orga (+ keyed)"
    },
    {
      "id": "H06",
      "displayOrder": 6,
      "text": "See beauty in things that others might not notice.",
      "dimension": "O",
      "facet": "O:AesA",
      "facetName": "Aesthetic Appreciation",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO O:AesA (+ keyed)"
    },
    {
      "id": "H07",
      "displayOrder": 7,
      "text": "Use flattery to get ahead.",
      "dimension": "H",
      "facet": "H:Sinc",
      "facetName": "Sincerity",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO H:Sinc (- keyed)"
    },
    {
      "id": "H08",
      "displayOrder": 8,
      "text": "Face danger confidently.",
      "dimension": "E",
      "facet": "E:Fear",
      "facetName": "Fearfulness",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO E:Fear (- keyed)"
    },
    {
      "id": "H09",
      "displayOrder": 9,
      "text": "Say little.",
      "dimension": "X",
      "facet": "X:Expr",
      "facetName": "Expressiveness",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO X:Expr (- keyed)"
    },
    {
      "id": "H10",
      "displayOrder": 10,
      "text": "Am inclined to forgive others.",
      "dimension": "A",
      "facet": "A:Forg",
      "facetName": "Forgiveness",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO A:Forg (+ keyed)"
    },
    {
      "id": "H11",
      "displayOrder": 11,
      "text": "Don't finish the things that I start.",
      "dimension": "C",
      "facet": "C:Orga",
      "facetName": "Organization",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO C:Orga (- keyed)"
    },
    {
      "id": "H12",
      "displayOrder": 12,
      "text": "Do not like art.",
      "dimension": "O",
      "facet": "O:AesA",
      "facetName": "Aesthetic Appreciation",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO O:AesA (- keyed)"
    },
    {
      "id": "H13",
      "displayOrder": 13,
      "text": "Would never take things that aren't mine.",
      "dimension": "H",
      "facet": "H:Fair",
      "facetName": "Fairness",
      "reverse": false,
      "sourceLocator": "IPIP-HEXACO H:Fair (+ keyed)"
    },
    {
      "id": "H14",
      "displayOrder": 14,
      "text": "Am willing to take risks.",
      "dimension": "E",
      "facet": "E:Fear",
      "facetName": "Fearfulness",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO E:Fear (- keyed)"
    },
    {
      "id": "H15",
      "displayOrder": 15,
      "text": "Bottle up my feelings.",
      "dimension": "X",
      "facet": "X:Expr",
      "facetName": "Expressiveness",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO X:Expr (- keyed)"
    },
    {
      "id": "H16",
