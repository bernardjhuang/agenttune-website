      "facet": "O:AesA",
      "facetName": "Aesthetic Appreciation",
      "reverse": true,
      "sourceLocator": "IPIP-HEXACO O:AesA (- keyed)"
    },
    {
      "id": "H19",
      "displayOrder": 19,
      "text": "Try to follow the rules.",
