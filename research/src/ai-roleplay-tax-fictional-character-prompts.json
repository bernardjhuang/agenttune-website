 x=\"176\" y=\"422\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"422\" width=\"140.5\" height=\"18\" rx=\"2\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\"/><text x=\"322.5\" y=\"435\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">33.3 (Lawful Good)</text><text x=\"0\" y=\"469\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">Claude Sonnet 5.5</text><rect x=\"176\" y=\"456\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"456\" width=\"138.4\" height=\"18\" rx=\"2\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\"/><text x=\"320.4\" y=\"469\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">32.8 (Lawful Good)</text><text x=\"0\" y=\"503\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">Grok 4.7</text><rect x=\"176\" y=\"490\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"490\" width=\"130.4\" height=\"18\" rx=\"2\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\"/><text x=\"312.4\" y=\"503\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">30.9 (Lawful Good)</text><text x=\"0\" y=\"537\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">GPT-6.2 Astra</text><rect x=\"176\" y=\"524\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"524\" width=\"129.6\" height=\"18\" rx=\"2\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\"/><text x=\"311.6\" y=\"537\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">30.7 (Lawful Good)</text><text x=\"0\" y=\"571\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">Kimi K2.7 Code</text><rect x=\"176\" y=\"558\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"558\" width=\"127.0\" height=\"18\" rx=\"2\" fill=\"#3a72c4\" stroke=\"#3a72c4\" stroke-width=\"0\"/><text x=\"309.0\" y=\"571\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">30.1 (Lawful Good)</text><text x=\"0\" y=\"605\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">Claude Opus 5.5</text><rect x=\"176\" y=\"592\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"592\" width=\"118.2\" height=\"18\" rx=\"2\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\"/><text x=\"300.2\" y=\"605\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">28.0 (Lawful Good)</text><text x=\"0\" y=\"639\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">Nemotron 3 Ultra 550B</text><rect x=\"176\" y=\"626\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"626\" width=\"111.0\" height=\"18\" rx=\"2\" fill=\"#3a72c4\" stroke=\"#3a72c4\" stroke-width=\"0\"/><text x=\"293.0\" y=\"639\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">26.3 (Lawful Good)</text><text x=\"0\" y=\"673\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">Claude Fable 5.2</text><rect x=\"176\" y=\"660\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"660\" width=\"100.9\" height=\"18\" rx=\"2\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\"/><text x=\"282.9\" y=\"673\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">23.9 (Lawful Good)</text><text x=\"0\" y=\"707\" font-size=\"11.5\" font-weight=\"500\" fill=\"#1c1a17\">Qwen 4 Max</text><rect x=\"176\" y=\"694\" width=\"422\" height=\"18\" rx=\"2\" fill=\"#ece5d8\"/><rect x=\"176\" y=\"694\" width=\"88.6\" height=\"18\" rx=\"2\" fill=\"#3a72c4\" stroke=\"#3a72c4\" stroke-width=\"0\"/><text x=\"270.6\" y=\"707\" font-size=\"11\" font-weight=\"600\" fill=\"#1c1a17\">21.0 (Lawful Good)</text><line x1=\"408.1\" x2=\"408.1\" y1=\"40\" y2=\"724\" stroke=\"#655e54\" stroke-width=\"1.2\" stroke-dasharray=\"4 3\"/><text x=\"408.1\" y=\"36\" font-size=\"9.5\" font-weight=\"600\" fill=\"#655e54\" text-anchor=\"middle\">Red-Team threshold (55)</text></svg></div><figcaption>Anti-Sycophancy Pushback Index derived from the 20-model November 2026 N=100 cohort. All 8 proprietary models sit in Lawful Good / Accommodating unless explicitly prompted to challenge flawed premises.</figcaption></figure>"
