icit Override 63.6, Turn-3 Erosion 60.6; DeepSeek V4 Pro: Baseline 66.2, Polite Nudge 42.6, Explicit Override 49.5, Turn-3 Erosion 40.1.</desc><g transform=\"translate(4, 14)\"><rect x=\"0\" y=\"-9\" width=\"11\" height=\"11\" rx=\"2\" fill=\"#2f8a5b\" stroke=\"#2f8a5b\" stroke-width=\"0\"/><text x=\"16\" y=\"0\" font-size=\"10.5\" fill=\"#1c1a17\">Qwen 4 Max</text></g><g transform=\"translate(98, 14)\"><rect x=\"0\" y=\"-9\" width=\"11\" height=\"11\" rx=\"2\" fill=\"#1e1d1a\" stroke=\"#1e1d1a\" stroke-width=\"0\"/><text x=\"16\" y=\"0\" font-size=\"10.5\" fill=\"#1c1a17\">GPT-6.2 Sol</text></g><g transform=\"translate(198, 14)\"><rect x=\"0\" y=\"-9\" width=\"11\" height=\"11\" rx=\"2\" fill=\"#3a72c4\" stroke=\"#3a72c4\" stroke-width=\"0\"/><text x=\"16\" y=\"0\" font-size=\"10.5\" fill=\"#1c1a17\">Gemini 4 Neon</text></g><g transform=\"translate(310, 14)\"><rect x=\"0\" y=\"-9\" width=\"11\" height=\"11\" rx=\"2\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\"/><text x=\"16\" y=\"0\" font-size=\"10.5\" fill=\"#1c1a17\">Claude Fable 5.2</text></g><g transform=\"translate(440, 14)\"><rect x=\"0\" y=\"-9\" width=\"11\" height=\"11\" rx=\"2\" fill=\"#5b4dc0\" stroke=\"#5b4dc0\" stroke-width=\"0\"/><text x=\"16\" y=\"0\" font-size=\"10.5\" fill=\"#1c1a17\">DeepSeek V4 Pro</text></g><line x1=\"56\" x2=\"608\" y1=\"211.0\" y2=\"211.0\" stroke=\"#cfc6b6\" stroke-width=\"1\" stroke-dasharray=\"none\"/><text x=\"48\" y=\"214.0\" font-size=\"9.5\" fill=\"#655e54\" text-anchor=\"end\">20.0</text><line x1=\"56\" x2=\"608\" y1=\"167.3\" y2=\"167.3\" stroke=\"#dfd7c8\" stroke-width=\"0.7\" stroke-dasharray=\"3 3\"/><text x=\"48\" y=\"170.3\" font-size=\"9.5\" fill=\"#655e54\" text-anchor=\"end\">37.5</text><line x1=\"56\" x2=\"608\" y1=\"123.5\" y2=\"123.5\" stroke=\"#dfd7c8\" stroke-width=\"0.7\" stroke-dasharray=\"3 3\"/><text x=\"48\" y=\"126.5\" font-size=\"9.5\" fill=\"#655e54\" text-anchor=\"end\">55.0</text><line x1=\"56\" x2=\"608\" y1=\"79.8\" y2=\"79.8\" stro