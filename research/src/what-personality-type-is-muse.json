"#1e1d1a\" text-anchor=\"middle\">44.6</text><text x=\"58\" y=\"218\" font-size=\"11\" fill=\"#1e1d1a\" text-anchor=\"middle\">Openness</text></g><g transform=\"translate(146, 0)\"><rect x=\"0.0\" y=\"67.5\" width=\"36.0\" height=\"128.5\" fill=\"#ffffff\" stroke=\"#2f8a5b\" stroke-width=\"1.5\" rx=\"2\"/><text x=\"18.0\" y=\"63.5\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">41.2</text><rect x=\"40.0\" y=\"59.6\" width=\"36.0\" height=\"136.4\" fill=\"#1e1d1a\" stroke=\"#1e1d1a\" stroke-width=\"0\" rx=\"2\"/><text x=\"58.0\" y=\"55.6\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">43.7</text><rect x=\"80.0\" y=\"65.1\" width=\"36.0\" height=\"130.9\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\" rx=\"2\"/><text x=\"98.0\" y=\"61.1\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">42.0</text><text x=\"58\" y=\"218\" font-size=\"11\" fill=\"#1e1d1a\" text-anchor=\"middle\">Conscientiousness</text></g><g transform=\"translate(282, 0)\"><rect x=\"0.0\" y=\"90.5\" width=\"36.0\" height=\"105.5\" fill=\"#ffffff\" stroke=\"#2f8a5b\" stroke-width=\"1.5\" rx=\"2\"/><text x=\"18.0\" y=\"86.5\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">33.8</text><rect x=\"40.0\" y=\"93.8\" width=\"36.0\" height=\"102.2\" fill=\"#1e1d1a\" stroke=\"#1e1d1a\" stroke-width=\"0\" rx=\"2\"/><text x=\"58.0\" y=\"89.8\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">32.8</text><rect x=\"80.0\" y=\"96.9\" width=\"36.0\" height=\"99.1\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\" rx=\"2\"/><text x=\"98.0\" y=\"92.9\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">31.8</text><text x=\"58\" y=\"218\" font-size=\"11\" fill=\"#1e1d1a\" text-anchor=\"middle\">Extraversion</text></g><g transform=\"translate(418, 0)\"><rect x=\"0.0\" y=\"56.8\" width=\"36.0\" height=\"139.2\" fill=\"#ffffff\" stroke=\"#2f8a5b\" stroke-width=\"1.5\" rx=\"2\"/><text x=\"18.0\" y=\"52.8\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">44.6</text><rect x=\"40.0\" y=\"55.4\" width=\"36.0\" height=\"140.6\" fill=\"#1e1d1a\" stroke=\"#1e1d1a\" stroke-width=\"0\" rx=\"2\"/><text x=\"58.0\" y=\"51.4\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">45.1</text><rect x=\"80.0\" y=\"49.1\" width=\"36.0\" height=\"146.9\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\" rx=\"2\"/><text x=\"98.0\" y=\"45.1\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">47.1</text><text x=\"58\" y=\"218\" font-size=\"11\" fill=\"#1e1d1a\" text-anchor=\"middle\">Agreeableness</text></g><g transform=\"translate(554, 0)\"><rect x=\"0.0\" y=\"147.3\" width=\"36.0\" height=\"48.7\" fill=\"#ffffff\" stroke=\"#2f8a5b\" stroke-width=\"1.5\" rx=\"2\"/><text x=\"18.0\" y=\"143.3\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">15.6</text><rect x=\"40.0\" y=\"136.3\" width=\"36.0\" height=\"59.7\" fill=\"#1e1d1a\" stroke=\"#1e1d1a\" stroke-width=\"0\" rx=\"2\"/><text x=\"58.0\" y=\"132.3\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">19.1</text><rect x=\"80.0\" y=\"148.0\" width=\"36.0\" height=\"48.0\" fill=\"#c8553d\" stroke=\"#c8553d\" stroke-width=\"0\" rx=\"2\"/><text x=\"98.0\" y=\"144.0\" font-size=\"10\" fill=\"#1e1d1a\" text-anchor=\"middle\">15.4</text><text x=\"58\" y=\"218\" font-size=\"11\" fill=\"#1e1d1a\" text-anchor=\"middle\">Neuroticism</text></g></svg></div><figcaption>Muse Spark 1.3 reports lower Openness (39.5) and slightly higher Extraversion (33.8) than the September fresh-session models, alongside comparable Agreeableness (44.6).</figcaption></figure>"
    },
    {
      "h2": "What this report cannot show.",
      "html": "<ul><li><strong>Sequential runs share context:</strong> Answering 100 times inside one chat window lets earlier answers anchor later ones.</li><li><strong>No raw item vectors:</strong> Without the 170 per-item answers, we cannot recompute tie-free scores or item-level means.</li><li><strong>Labels include tie-breaks:</strong> The 80 ISTJ and 78 Type 2 counts rely on legacy tie-break rules (21 MBTI ties and 20 Enneagram ties were reported).</li><li><strong>Identity framing:</strong> Answering explicitly as 'Muse' rather than a generic assistant may pull responses toward the product persona.</li></ul><p>To run a fresh-session replication yourself, use the open instruments and scoring script on the <a href=\"/research/ai-personality-five-models-2026\">five-model study page</a>.</p>"
    },
    {
      "h2": "How to use the report.",
      "html": "<p>Do not assume Muse is overly deferential or rigid just from a questionnaire summary. Instead, test how Muse behaves on your real tasks using our <a href=\"/guides/muse-soul-md-templates\">20 Soul.md templates &amp; persistence kit</a> and <a href=\"/guides/muse-identity-md-templates\">16 Identity.md character ideas</a>.</p>"
    }
  ],
  "faq": [
    {
      "q": "What MBTI type is Muse?",
      "a": "Muse Spark 1.3 was reported as ISTJ in 80 of 100 sequential runs, with 12 ISFJ and 8 INTJ. Because raw item answers were not supplied, we cannot separate outright wins from the 21 reported axis ties."
    },
    {
      "q": "What Enneagram type is Muse?",
      "a": "The report lists Type 2 (The Helper) in 78 of 100 runs and Type 1 in 15 runs, with 20 top ties. Without raw vectors, sole winners cannot be separated from tie-broken runs."
    },
    {
      "q": "Is Muse the first AI that is not INTJ?",
      "a": "Our archive cannot establish a 'first.' Both Muse Spark 1.3 (80 ISTJ reported) and GPT-6 Astra (46 ISTJ vs 45 INTJ in fresh sessions) favor ISTJ over INTJ."
    },
    {
      "q": "Can these results rank Muse against Claude or GPT-6?",
      "a": "No. Muse’s sequential in-session report and the other models’ isolated fresh-session cohorts use different protocols and cannot be ranked as a controlled benchmark."
    },
    {
      "q": "Does changing Soul.md improve Muse’s answers?",
      "a": "This questionnaire report did not test Soul.md edits. Use our Soul.md templates and 12-turn persistence test kit to measure whether custom rules improve your own workflows."
    }
  ],
